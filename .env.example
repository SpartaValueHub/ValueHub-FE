# =============================================================================
# ValueHub-FO — 노트북 개발 환경 (Gateway :8000)
# =============================================================================
# 접속 URL 2가지 (동일 노트북, FO 포트 3000):
#   - 이 PC:     http://localhost:3000
#   - 팀원 LAN:  http://192.168.10.45:3000
#
# Gateway도 2가지:
#   - http://localhost:8000
#   - http://192.168.10.45:8000
# =============================================================================

# --- Gateway (서버 사이드: Next.js → auth/chat REST) ---
# auth-service 경로 prefix 포함. 노트북에서 FO와 Gateway가 같이 돌면 localhost 사용.
API_URL=http://localhost:8000/auth-service
CHAT_API_URL=http://localhost:8000/chat-service

# --- 브라우저 SSE (EventSource, CORS 대상) ---
# localhost 로 두면 LAN IP 접속 시 lib/chat/sse.ts 가 hostname 을 192.168.10.45 로 자동 치환.
NEXT_PUBLIC_CHAT_API_URL=http://localhost:8000/chat-service

# --- NextAuth (LAN IP 로그인 시 NEXTAUTH_URL 고정 금지) ---
AUTH_TRUST_HOST=true
AUTH_SECRET=change-me-local-dev-only-min-32-characters
