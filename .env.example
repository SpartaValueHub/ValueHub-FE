# Gateway auth-service (서버 전용 — NEXT_PUBLIC_ 사용 금지)
API_URL=http://localhost:8000/auth-service

# Gateway member-service (서버 전용 — 미설정 시 API_URL의 auth-service → member-service 치환)
MEMBER_API_URL=http://localhost:8000/member-service

# 약관 Data Cache 무효화 — POST /api/revalidate/terms Bearer (서버 전용, NEXT_PUBLIC_ 금지)
TERMS_REVALIDATE_SECRET=

# NextAuth (Auth.js) — 세션 memberUuid·nickname·role만 보관
AUTH_SECRET=
NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true

# HttpOnly JWT 쿠키 — auth-service·Gateway와 동일 이름 유지
AUTH_COOKIE_ACCESS_NAME=vh_access_token
AUTH_COOKIE_REFRESH_NAME=vh_refresh_token

# PortOne 본인인증 (클라이언트 SDK — Store ID·Channel Key만 공개)
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=

# Google reCAPTCHA v2 (로그인 5번째 실패 직후 위젯 표시 — Site Key만 공개)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# auth-service refresh·logout Origin 검증 — apiFetch Origin 헤더 (prod require-origin=true 시 필수)
# 로컬: http://localhost:3000 / prod: https://valuehub.example.com
AUTH_TRUSTED_ORIGIN=

# Server-side backend request timeouts (milliseconds)
API_TIMEOUT_MILLIS=5000
AUTH_SIGNUP_TIMEOUT_MILLIS=10000
IDENTITY_CONFIRM_TIMEOUT_MILLIS=12000
